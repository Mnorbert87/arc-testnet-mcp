# Arc testnet RPC (default is the public endpoint)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Explorer API base (Blockscout). Default works out of the box.
ARC_EXPLORER_API=https://testnet.arcscan.app/api

# Only needed to SEND transactions. Use a throwaway testnet key, never a real one.
# Fund it first at https://faucet.circle.com
ARC_PRIVATE_KEY=
